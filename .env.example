# Copie para .env e preencha. Nunca versione o .env.

# Postgres
POSTGRES_USER=voiceagent
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=voiceagent

# MinIO (gravações)
MINIO_ROOT_USER=voiceagent
MINIO_ROOT_PASSWORD=troque-esta-senha-minio
MINIO_BUCKET=recordings

# Bootstrap: criados na primeira subida se não existir nenhum User
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-esta-senha-admin
ORG_NAME=Minha Organização

# Voice Provider: Gemini Live
GEMINI_API_KEY=

# Voice Provider opcional: OpenAI Realtime
OPENAI_API_KEY=

# Guardião Jev via OpenRouter (typesafe/jev-router)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=typesafe/jev-router
TYPESAFE_API_KEY=

# Painel
FRONTEND_PORT=8088
# true quando servido via HTTPS
COOKIE_SECURE=false
LOG_LEVEL=info

# Telefonia SIP / Media Server (Jambonz)
# Preencha quando conectar seu trunk SIP e Jambonz
JAMBONZ_API_URL=
JAMBONZ_API_KEY=
JAMBONZ_ACCOUNT_SID=
PUBLIC_WS_URL=
